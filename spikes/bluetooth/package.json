{
  "name": "@restroos/spike-bluetooth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sprint 1 Bluetooth spike: hub GATT prototype + Web Bluetooth measurement page. Not production code.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "hub": "tsx src/hub.ts",
    "build:web": "esbuild web/main.ts --bundle --format=esm --target=chrome100 --minify --sourcemap --outfile=web/dist/main.js",
    "web": "pnpm build:web && tsx src/serve-web.ts"
  },
  "dependencies": {
    "@restroos/contracts": "workspace:*"
  },
  "optionalDependencies": {
    "@abandonware/bleno": "0.6.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15"
  }
}
