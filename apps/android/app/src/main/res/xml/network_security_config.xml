<?xml version="1.0" encoding="utf-8"?>
<!-- The Hub is on the restaurant's own network, usually by IP address over plain HTTP. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <!-- A Hub's self-signed HTTPS certificate, once installed on the tablet. -->
      <certificates src="user" />
    </trust-anchors>
  </base-config>
</network-security-config>
