<?xml version="1.0" encoding="utf-8"?>
<!-- One screen: the Hub's web app, with the connect form or the "can't reach" panel over it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/surface">

  <WebView
    android:id="@+id/web"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone" />

  <ScrollView
    android:id="@+id/connect"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:padding="32dp">

      <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/logo_background"
        android:contentDescription="@null"
        android:src="@drawable/ic_launcher_foreground"
        android:scaleType="centerCrop" />

      <TextView
        android:id="@+id/connect_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/connect_title"
        android:textColor="@color/on_surface"
        android:textSize="24sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxWidth="480dp"
        android:text="@string/connect_body"
        android:textColor="@color/muted"
        android:textSize="16sp" />

      <EditText
        android:id="@+id/address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxWidth="480dp"
        android:autofillHints="url"
        android:hint="@string/connect_address"
        android:imeOptions="actionGo"
        android:inputType="textUri"
        android:minHeight="56dp"
        android:singleLine="true"
        android:textSize="20sp" />

      <TextView
        android:id="@+id/connect_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/danger"
        android:textSize="15sp"
        android:visibility="gone" />

      <CheckBox
        android:id="@+id/kiosk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:text="@string/connect_kiosk"
        android:textSize="16sp" />

      <Button
        android:id="@+id/connect_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/brand"
        android:minHeight="56dp"
        android:text="@string/connect_button"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />
    </LinearLayout>
  </ScrollView>

  <LinearLayout
    android:id="@+id/unreachable"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:text="@string/hub_unreachable_title"
      android:textColor="@color/on_surface"
      android:textSize="24sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/unreachable_body"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center"
      android:maxWidth="480dp"
      android:textColor="@color/muted"
      android:textSize="16sp" />

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:orientation="horizontal">

      <Button
        android:id="@+id/retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/brand"
        android:minHeight="56dp"
        android:text="@string/hub_retry"
        android:textColor="#FFFFFF" />

      <Button
        android:id="@+id/change"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:minHeight="56dp"
        android:text="@string/hub_change"
        android:textColor="@color/brand" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
