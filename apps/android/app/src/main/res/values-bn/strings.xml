<resources>
  <string name="connect_title">আপনার RestroOS হাবে যুক্ত হন</string>
  <string name="connect_body">হাব পিসিতে দেখানো ঠিকানা লিখুন (সেটিংস → ডিভাইস), যেমন 192.168.1.20।</string>
  <string name="connect_address">হাবের ঠিকানা</string>
