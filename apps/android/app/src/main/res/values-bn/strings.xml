  <string name="connect_invalid">এটি ঠিকানা নয়। 192.168.1.20-এর মতো কিছু লিখুন।</string>
  <string name="connect_unreachable">%1$s-এ কোনো হাব পাওয়া যায়নি। দেখুন হাব পিসি চালু আছে এবং এই ট্যাবলেট একই ওয়াই-ফাইতে আছে।</string>
  <string name="connect_not_hub">%1$s-এ কিছু সাড়া দিয়েছে, কিন্তু সেটি RestroOS হাব নয়।</string>
  <string name="connect_kiosk">এই ট্যাবলেটে অ্যাপ পিন করুন (কিয়স্ক)</string>
  <string name="hub_unreachable_title">হাবে পৌঁছানো যাচ্ছে না</string>
  <string name="hub_unreachable_body">%1$s-এ হাব সাড়া দিচ্ছে না। ওয়াই-ফাই দেখুন এবং হাব পিসি চালু আছে কিনা দেখুন।</string>
  <string name="hub_retry">আবার চেষ্টা করুন</string>
